# Athan for Alexa Backend - Environment Variables
# Copy this file to .env and fill in your values

# Encryption key for LWA tokens (auto-generated, keep secret)
ENCRYPTION_KEY=<paste the generated key here>

# Login with Amazon credentials
# Get these from https://developer.amazon.com/loginwithamazon/console/site/lwa/overview.html
LWA_CLIENT_ID=amzn1.application-oa2-client.XXXXXXXXXXXX
LWA_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
