# ============================================================
# Athan for Alexa — Environment Variables (Single Source of Truth)
# ============================================================
# Copy this file to .env and fill in your values.
# This file is used by ALL components (backend, alexa-skill).

# --- Encryption ---
# Key for encrypting LWA tokens at rest in DynamoDB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<paste the generated key here>

# --- Login with Amazon (LWA) ---
# Get these from https://developer.amazon.com/loginwithamazon/console/site/lwa/overview.html
LWA_CLIENT_ID=amzn1.application-oa2-client.XXXXXXXXXXXX
LWA_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Alexa Skill Messaging ---
# Get these from Alexa Developer Console > Your Skill > Build > Permissions
# (Used by the backend cron to send prayer times to the skill via Skill Messaging API)
SKILL_CLIENT_ID=amzn1.application-oa2-client.XXXXXXXXXXXX
SKILL_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
